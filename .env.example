# Thanarah AI — Environment Configuration Example
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=TAI

# Authentication
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (32 bytes hex for AES-256)
ENCRYPTION_KEY=

# Server ports
API_PORT=3001
AI_ENGINE_PORT=8000

# AI Engine
AI_ENGINE_URL=http://localhost:8000

# Local AI (llama.cpp compatible)
LOCAL_AI_ENABLED=false
LOCAL_AI_ENGINE=llamacpp
LOCAL_AI_BASE_URL=http://localhost:8080
LOCAL_AI_MODEL=

# External providers (BYOK — optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=
