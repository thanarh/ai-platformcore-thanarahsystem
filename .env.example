# Thanarah AI — Environment Configuration Example
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/thanarah_ai

# Authentication
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (32 bytes hex for AES-256)
ENCRYPTION_KEY=

# Server ports
API_PORT=3001
AI_ENGINE_PORT=8000

# AI Engine
AI_ENGINE_URL=http://localhost:8000

# Phase 4 AI Gateway foundation. Core integration stays disabled until the
# Thanarah Core API contract is available. Mock data is for local tests only.
AI_GATEWAY_ENABLED=true
THANARAH_CORE_TOOLS_ENABLED=false
TOOL_MOCK_ENABLED=false

# Local AI (free local inference; Ollama is recommended)
LOCAL_AI_ENABLED=true
LOCAL_AI_ENGINE=ollama
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_MODEL=qwen2.5:0.5b
LOCAL_AI_KEEP_ALIVE=10m
OLLAMA_KEEP_ALIVE=10m
LOCAL_AI_COLD_LOAD_THRESHOLD_MS=1000
LOCAL_AI_RUNTIME_PROBE_TIMEOUT_SECONDS=2
LOCAL_AI_NUM_CTX=2048
LOCAL_AI_NUM_THREAD=4
LOCAL_AI_NUM_BATCH=64
LOCAL_AI_MAX_CONCURRENCY=1
LOCAL_AI_MAX_QUEUE=32
LOCAL_AI_QUEUE_TIMEOUT_SECONDS=180
LOCAL_AI_MAX_TOKENS_FAST=96
LOCAL_AI_MAX_TOKENS_BALANCED=256
LOCAL_AI_MAX_TOKENS_DEEP=512

# Lightweight continual memory: retrieval only, no per-request model training
MEMORY_ENABLED=true
MEMORY_CACHE_SIZE=256
MEMORY_RECALL_LIMIT=3
MEMORY_SCAN_LIMIT=5000
MEMORY_MAX_PER_TENANT=100000
MEMORY_ITEM_CHARS=1000
MEMORY_MIN_SCORE=0.15
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_SIZE=2048
RESPONSE_CACHE_TTL_SECONDS=21600
RESPONSE_CACHE_PROMPT_TTL_SECONDS=604800
PERSISTENT_RESPONSE_CACHE_ENABLED=true
PERSISTENT_RESPONSE_CACHE_TTL_SECONDS=604800
RESPONSE_CACHE_DB_TIMEOUT_SECONDS=1.0
RESPONSE_CACHE_SEMANTIC_SCAN_LIMIT=250
RESPONSE_CACHE_SEMANTIC_MIN_SCORE=0.92

# Free local embeddings (Sentence Transformers is optional; hashing fallback is automatic)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_FALLBACK_DIMENSION=384

# RAG backend. Legacy MongoDB RAG remains the safe default.
RAG_BACKEND=legacy
LEGACY_RAG=true
QDRANT_RAG=false
QDRANT_ENABLED=false
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=thanarah_knowledge
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=3
QDRANT_CANDIDATE_LIMIT=25
RAG_RERANKER_ENABLED=true
RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_CONTEXT_LIMIT=3
RAG_CHUNK_SIZE=350
RAG_CHUNK_OVERLAP=40

# External providers are disabled by default.
# Keep FREE_PROVIDER_ONLY=true to hard-block paid OpenAI/Anthropic adapters.
ALLOW_EXTERNAL_PROVIDERS=false
FREE_PROVIDER_ONLY=true
FREE_PROVIDERS_ENABLED=false

# Provider-neutral high-quality primary service. Keep the key server-side only.
EXTERNAL_AI_ENABLED=false
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_BASE_URL=https://api.openai.com/v1
EXTERNAL_AI_MODEL=
EXTERNAL_AI_MAX_TOKENS_FIELD=max_tokens
EXTERNAL_AI_TIMEOUT_SECONDS=90
EXTERNAL_AI_MAX_RETRIES=2
EXTERNAL_AI_MAX_CONCURRENCY=16
EXTERNAL_AI_DAILY_LIMIT=50000
EXTERNAL_AI_RPM_LIMIT=300
EXTERNAL_AI_DAILY_BUDGET_USD=10
EXTERNAL_AI_INPUT_PRICE_PER_MILLION=0
EXTERNAL_AI_OUTPUT_PRICE_PER_MILLION=0
EXTERNAL_AI_MAX_TOKENS_FAST=256
EXTERNAL_AI_MAX_TOKENS_BALANCED=768
EXTERNAL_AI_MAX_TOKENS_DEEP=1600

# Optional free API fallbacks. Quota-guarded and never required locally.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_DAILY_LIMIT=100
GROQ_RPM_LIMIT=10
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_DAILY_LIMIT=100
OPENROUTER_RPM_LIMIT=10

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=
# Public production origin used by canonical, sitemap, Open Graph, and logo metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
