{
  "name": "thanarah-ai",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10.9.0 <12"
  },
  "description": "Thanarah AI — Independent AI Infrastructure Platform",
  "scripts": {
    "dev": "concurrently --names \"WEB,API,AI\" --prefix-colors \"green,blue,yellow\" \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:ai\"",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:ai": "cd services/ai-engine && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "build": "npm run build:api && npm run build:web",
    "build:web": "cd apps/web && npm run build",
    "build:api": "cd apps/api && npm run build",
    "test:phone": "npm run build:api && node --test tests/regression/phone_enrollment.test.cjs tests/regression/whatsapp_baileys_scaffold.test.cjs",
    "test:phone:mongo": "npm run build:api && PHONE_ENROLLMENT_MONGO_TEST=1 node --test --test-force-exit tests/regression/phone_enrollment_mongo.test.cjs",
    "test:phone:web": "playwright test --config=playwright.config.cjs",
    "test:embedded": "npm run build:api && node --test tests/regression/embedded_integration.test.cjs",
    "test:embedded:mongo": "npm run build:api && EMBEDDED_MONGO_TEST=1 node --test --test-force-exit tests/regression/embedded_mongo.test.cjs",
    "test:embedded:web": "EMBED_BROWSER_TEST=1 playwright test --config=playwright.config.cjs --grep different-origin",
    "install:all": "npm install && cd apps/web && npm install && cd ../api && npm install",
    "start": "concurrently --names \"WEB,API,AI\" --prefix-colors \"green,blue,yellow\" \"npm run start:web\" \"npm run start:api\" \"npm run start:ai\"",
    "start:web": "cd apps/web && npm run start",
    "start:api": "cd apps/api && npm run start:prod",
    "start:ai": "cd services/ai-engine && python -m uvicorn main:app --host 0.0.0.0 --port 8000"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "dependencies": {
    "@playwright/test": "^1.65.1",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "libphonenumber-js": "^1.13.16",
    "qrcode": "^1.5.4"
  }
}
