{
  "name": "thanarah-ai",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.13.x",
    "npm": ">=10.9.0 <12"
  },
  "description": "Thanarah AI — Independent AI Infrastructure Platform",
  "scripts": {
    "dev": "concurrently --names \"WEB,API,AI\" --prefix-colors \"green,blue,yellow\" \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:ai\"",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:ai": "cd services/ai-engine && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "build": "npm run build:api && npm run build:web",
    "build:web": "cd apps/web && npm run build",
    "build:api": "cd apps/api && npm run build",
    "install:all": "npm install && cd apps/web && npm install && cd ../api && npm install",
    "start": "concurrently --names \"WEB,API,AI\" --prefix-colors \"green,blue,yellow\" \"npm run start:web\" \"npm run start:api\" \"npm run start:ai\"",
    "start:web": "cd apps/web && npm run start",
    "start:api": "cd apps/api && npm run start:prod",
    "start:ai": "cd services/ai-engine && python -m uvicorn main:app --host 0.0.0.0 --port 8000"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "date-fns": "^4.4.0",
    "helmet": "^8.3.0",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.31.0",
    "mongoose": "^9.9.2",
    "multer": "^2.2.0",
    "next": "^16.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  }
}
