modules = ["nodejs-20", "python-3.12", "bash", "web"]
[nix]
channel = "stable-25_05"
packages = ["cargo", "glibcLocales", "libiconv", "libxcrypt", "rustc"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
# Non-sensitive service configuration — safe to commit.
# Secrets (MONGODB_URI, JWT_SECRET, JWT_REFRESH_SECRET, ENCRYPTION_KEY) must be
# stored in Replit Secrets (padlock icon in the sidebar), NOT here.
AI_ENGINE_PORT = "8000"
AI_ENGINE_URL = "http://localhost:8000"
API_PORT = "3001"
LOCAL_AI_BASE_URL = "http://localhost:11434"
LOCAL_AI_ENABLED = "true"
LOCAL_AI_ENGINE = "llamacpp"
NEXT_PORT = "5000"
NEXT_PUBLIC_API_URL = ""
NODE_ENV = "development"
NEXT_API_URL = "http://localhost:3001"
LOCAL_AI_MODEL = "qwen2.5:1.5b"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start-dev.sh"
waitForPort = 5000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[deployment]
deploymentTarget = "vm"
build = ["bash", "build.sh"]
run = ["bash", "start.sh"]
