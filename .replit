modules = ["python-3.12", "bash", "web", "nodejs-22"]
[nix]
channel = "stable-25_05"
packages = ["cargo", "glibcLocales", "libiconv", "libxcrypt", "rustc", "python313Packages.filelock", "python313Packages.idna", "python313Packages.certifi", "python313Packages.urllib3", "python313Packages.requests", "python313Packages.pyyaml", "python313Packages.faster-whisper", "ffmpeg", "espeak-ng", "piper-tts", "python312Packages.pandas", "python312Packages.openpyxl", "python312Packages.reportlab", "zstd"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
# Non-sensitive service configuration — safe to commit.
# Secrets (MONGODB_URI, JWT_SECRET, JWT_REFRESH_SECRET, ENCRYPTION_KEY) must be
# stored in Replit Secrets (padlock icon in the sidebar), NOT here.
AI_ENGINE_PORT = "8000"
AI_ENGINE_URL = "http://localhost:8000"
API_PORT = "3001"
LOCAL_AI_BASE_URL = "http://localhost:11434"
LOCAL_AI_ENABLED = "true"
LOCAL_AI_ENGINE = "llamacpp"
NEXT_PORT = "5000"
NEXT_PUBLIC_API_URL = ""
NODE_ENV = "development"
NEXT_API_URL = "http://localhost:3001"
LOCAL_AI_MODEL = "qwen2.5:1.5b"

[userenv.development]
EXTERNAL_AI_DAILY_BUDGET_USD = "0.19"
EXTERNAL_AI_DAILY_LIMIT = "200"
EXTERNAL_AI_ENABLED = "true"
EXTERNAL_AI_INPUT_PRICE_PER_MILLION = "0.5"
EXTERNAL_AI_MAX_CONCURRENCY = "4"
EXTERNAL_AI_MAX_RETRIES = "0"
EXTERNAL_AI_MAX_TOKENS_FAST = "192"
EXTERNAL_AI_MODEL = "gpt-5-nano"
EXTERNAL_AI_OUTPUT_PRICE_PER_MILLION = "2.0"
EXTERNAL_AI_RPM_LIMIT = "20"
EXTERNAL_AI_TIMEOUT_SECONDS = "4.0"
OPENAI_WEB_SEARCH_DAILY_BUDGET_USD = "0.06"
EXTERNAL_AI_MAX_TOKENS_FIELD = "max_completion_tokens"

[userenv.production]
EXTERNAL_AI_DAILY_BUDGET_USD = "0.19"
EXTERNAL_AI_DAILY_LIMIT = "200"
EXTERNAL_AI_ENABLED = "true"
EXTERNAL_AI_INPUT_PRICE_PER_MILLION = "0.5"
EXTERNAL_AI_MAX_CONCURRENCY = "4"
EXTERNAL_AI_MAX_RETRIES = "0"
EXTERNAL_AI_MAX_TOKENS_FAST = "192"
EXTERNAL_AI_MAX_TOKENS_FIELD = "max_completion_tokens"
EXTERNAL_AI_MODEL = "gpt-5-nano"
EXTERNAL_AI_OUTPUT_PRICE_PER_MILLION = "2.0"
EXTERNAL_AI_RPM_LIMIT = "20"
EXTERNAL_AI_TIMEOUT_SECONDS = "4.0"
OPENAI_WEB_SEARCH_DAILY_BUDGET_USD = "0.06"
WEB_SEARCH_ENABLED = "true"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "web-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "whatsapp-baileys"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "WEB_SEARCH_ENABLED=true SEARXNG_URL=http://127.0.0.1:8080 bash start-dev.sh"
waitForPort = 5000

[[workflows.workflow]]
name = "web-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/web && npx tsc --noEmit --incremental false"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "whatsapp-baileys"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build --prefix apps/api && node --test tests/regression/whatsapp_baileys_scaffold.test.cjs"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 23636
externalPort = 3002

[deployment]
deploymentTarget = "vm"
build = ["bash", "build.sh"]
run = ["bash", "start.sh"]
